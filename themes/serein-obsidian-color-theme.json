  "tokenColors": [
    {
      "settings": {
        "foreground": "#C7C3BA",
        "background": "#191817"
      }
    },
    {
      "name": "Comments: readable, upright",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A39E95",
        "fontStyle": ""
      }
    },
    {
      "name": "Structural keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C9848F",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#C7C3BA",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#9FAE94"
      }
    },
    {
      "name": "Literal values",
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#98A9BD"
      }
    },
    {
      "name": "Names",
      "scope": [
        "variable",
        "entity.name",
        "support",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C7C3BA",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#C7C3BA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#C9848F",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Inserted / deleted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#9FAE94"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#CF8179"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#C7C3BA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C7C3BA",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "*": {
      "foreground": "#C7C3BA",
      "italic": false
    },
    "comment": {
      "foreground": "#A39E95",
      "italic": false
    },
    "keyword": "#C9848F",
    "modifier": "#C9848F",
    "string": "#9FAE94",
    "number": "#98A9BD",
    "operator": "#C7C3BA",
    "enumMember": "#98A9BD"
  }
