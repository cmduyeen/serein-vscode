  "tokenColors": [
    {
      "settings": {
        "foreground": "#3D3A36",
        "background": "#F6F4F0"
      }
    },
    {
      "name": "Comments: readable, upright",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5C5852",
        "fontStyle": ""
      }
    },
    {
      "name": "Structural keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#914854",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#3D3A36",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#405D3D"
      }
    },
    {
      "name": "Literal values",
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#435872"
      }
    },
    {
      "name": "Names",
      "scope": [
        "variable",
        "entity.name",
        "support",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#3D3A36",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#3D3A36",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#914854",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Inserted / deleted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#405D3D"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#963D37"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#3D3A36",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#3D3A36",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "*": {
      "foreground": "#3D3A36",
      "italic": false
    },
    "comment": {
      "foreground": "#5C5852",
      "italic": false
    },
    "keyword": "#914854",
    "modifier": "#914854",
    "string": "#405D3D",
    "number": "#435872",
    "operator": "#3D3A36",
    "enumMember": "#435872"
  }
}
